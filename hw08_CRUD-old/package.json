    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "mysql2": "^3.14.4",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
     "ts-node": "^10.9.2",
    "umzug": "^3.8.2"
  }
